{
  "name": "undabot/json-api-core",
  "description": "Framework-agnostic JSON:API specification core library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.4",
    "beberlei/assert": "^3.3"
  },
  "require-dev": {
    "ekino/phpstan-banned-code": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-beberlei-assert": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "Undabot\\JsonApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Undabot\\JsonApi\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "php-cs-fixer fix --diff --ansi --dry-run"
    ],
    "phpstan": [
      "phpstan analyse -n --ansi --no-progress"
    ],
    "test": [
      "phpunit"
    ],
    "qc": [
      "@lint",
      "@phpstan",
      "@test"
    ]
  }
}
